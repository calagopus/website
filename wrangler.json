{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "website",
  "compatibility_date": "2026-08-18",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./.vitepress/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/docs",
      "/docs/*",
      "/compare",
      "/compare/*",
      "/ai-doc/*",
      "/*.md",
      "/mcp",
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "VERSION_CACHE",
      "id": "f1f42cea66814541b1bf1b427bb2bb48"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default",
      "remote": true
    }
  ],
  "vars": {
    "AI_SEARCH_INSTANCE": "website",
    "CLICKHOUSE_DATABASE": "telemetry"
  },
  "secrets": {
    "required": [
      "GITHUB_TOKEN",
      "CLICKHOUSE_URL",
      "CLICKHOUSE_USER",
      "CLICKHOUSE_PASSWORD"
    ]
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "TELEMETRY_UUID_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "TELEMETRY_IP_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
