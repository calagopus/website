{
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "license": "MIT",
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "node scripts/ensure-git-history.mjs && vitepress build",
    "docs:preview": "vitepress preview",
    "worker:dev": "wrangler dev --local",
    "worker:deploy": "wrangler deploy",
    "worker:types": "wrangler types --path worker/worker-configuration.d.ts",
    "typecheck": "pnpm run worker:types && tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "check-config-docs": "node scripts/check-config-docs.mjs",
    "check-worker-routes": "node scripts/check-worker-routes.mjs",
    "apply-clickhouse-schema": "node scripts/apply-clickhouse-schema.mjs",
    "sync-ai-search": "node scripts/sync-ai-search.mjs",
    "biome:validate": "biome format --css-parse-tailwind-directives=true && biome lint --css-parse-tailwind-directives=true && biome check",
    "biome:fix": "biome format --write --css-parse-tailwind-directives=true && biome lint --write --css-parse-tailwind-directives=true && biome check --write",
    "biome:fix-unsafe": "biome format --write --css-parse-tailwind-directives=true && biome lint --write --css-parse-tailwind-directives=true && biome check --write --unsafe"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@braintree/sanitize-url": "^7.1.2",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/node": "^26.4.1",
    "@unhead/vue": "^3.4.0",
    "agents": "^0.22.0",
    "cytoscape": "^3.34.2",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.23",
    "debug": "^4.4.3",
    "echarts": "^6.1.0",
    "markdown-it": "^15.0.1",
    "mermaid": "^11.17.2",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "viewerjs": "^1.12.0",
    "vite": "^8.2.2",
    "vite-imagetools": "^12.0.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitepress": "2.0.0-alpha.19",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitepress-plugin-tabs": "^0.9.1",
    "vitepress-plugin-viewerjs": "^2.0.1",
    "vue": "^3.5.42",
    "vue-echarts": "^8.2.0",
    "wrangler": "^4.129.0",
    "zod": "^4.5.4"
  }
}
