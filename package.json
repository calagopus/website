{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "node scripts/ensure-git-history.mjs && vitepress build",
    "docs:preview": "vitepress preview",
    "worker:dev": "wrangler dev --local",
    "worker:deploy": "wrangler deploy",
    "worker:types": "wrangler types --path worker/worker-configuration.d.ts",
    "typecheck": "pnpm run worker:types && tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "check-config-docs": "node scripts/check-config-docs.mjs",
    "check-worker-routes": "node scripts/check-worker-routes.mjs",
    "apply-clickhouse-schema": "node scripts/apply-clickhouse-schema.mjs",
    "sync-ai-search": "node scripts/sync-ai-search.mjs",
    "check-telemetry-clickhouse": "node scripts/check-telemetry-clickhouse.mjs",
    "check-telemetry-policy": "node scripts/check-telemetry-policy.mjs",
    "telemetry": "node --env-file=.dev.vars scripts/telemetry.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@modelcontextprotocol/server": "^2.4.0",
    "@sentry/cloudflare": "^11.11.0",
    "@types/node": "^26.6.6",
    "@unhead/vue": "^3.4.3",
    "agents": "^0.33.0",
    "cytoscape": "^3.34.4",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.23",
    "debug": "^4.4.3",
    "echarts": "^6.1.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.3.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-imagetools": "^12.0.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitepress-plugin-tabs": "^0.9.1",
    "vue": "^3.5.45",
    "vue-echarts": "^8.3.2",
    "wrangler": "^4.158.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  }
}
